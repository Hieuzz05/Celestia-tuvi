# ============================================================
# Sao chép file này thành .env.local rồi điền giá trị thật.
# Trên Vercel: khai báo từng biến ở Settings > Environment Variables.
# KHÔNG commit .env.local lên git.
# ============================================================

# ---------- EMBEDDING CHO KHO TRI THỨC ----------
# Nhà cung cấp sinh vector: gemini (mặc định) hoặc openai.
#
# Gemini nằm trong gói miễn phí nhưng có hai trần cứng: 100 đoạn mỗi phút và
# 1.000 đoạn mỗi ngày. Cả kho tri thức vài nghìn đoạn, nên nạp hết mất nhiều
# ngày — đó mới là nút thắt thật khi nạp sách, không phải kích thước tệp.
#
# openai dùng text-embedding-3-small với tham số dimensions=768, khớp đúng cột
# vector(768) đang có nên không phải đổi bảng. Đo 18/09/2026: 3.000 lượt/phút,
# 1 triệu token/phút, không có trần ngày, 120 đoạn trong 1,8 giây. Giá 0,02 đô
# la cho một triệu token.
#
# QUAN TRỌNG — hai điều sai lặng lẽ nếu làm thiếu:
#  1. Đổi giá trị này thì PHẢI sinh lại vector cho toàn bộ kho:
#     npx tsx scripts/nap-lai-embedding.ts --tat-ca
#     Vector của hai model nằm trong hai không gian khác nhau. Trộn chúng không
#     báo lỗi gì cả, truy vấn vẫn chạy, chỉ là kết quả vô nghĩa.
#  2. Giá trị ở máy và trên Vercel PHẢI giống nhau. Vector câu hỏi và vector tài
#     liệu buộc phải do cùng một model sinh ra.
EMBEDDING_PROVIDER=gemini

# Để trống là dùng mặc định của nhà cung cấp
# EMBEDDING_MODEL=text-embedding-3-small

# ---------- MODEL AI (cần ít nhất một key để bật luận giải) ----------
# Gemini: tier miễn phí dùng được thật — lấy tại https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Groq: free tier ~1000 request/ngày, không cần thẻ, tốc độ rất nhanh
# https://console.groq.com/keys
GROQ_API_KEY=

# Cerebras: free tier, không cần thẻ — https://cloud.cerebras.ai
CEREBRAS_API_KEY=

# OpenRouter: gom nhiều model mã nguồn mở có bản :free — https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Hai nhà cung cấp dưới đây không có tier miễn phí thật, chỉ điền khi có ngân sách
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Thứ tự fallback (tuỳ chọn).
# Bỏ trống thì tự xếp: gemini > groq > cerebras > openrouter > openai > anthropic
# Cú pháp: provider|model, cách nhau bằng dấu phẩy
AI_FALLBACK_ORDER=gemini|gemini-3.6-flash,openrouter|deepseek/deepseek-chat-v3-0324:free

# ---------- DATABASE & ĐĂNG NHẬP (Supabase) ----------
# Lấy tại Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chỉ dùng phía server, tuyệt đối không để lộ ra client.
# BẮT BUỘC nếu muốn dùng Kho tri thức (RAG) — kho này chặn anon key hoàn toàn.
SUPABASE_SERVICE_ROLE_KEY=

# ---------- QUẢN TRỊ ----------
# Email được vào trang /admin, cách nhau bằng dấu phẩy.
# Bỏ trống = ai cũng vào được (chỉ nên dùng khi chạy máy cá nhân).
ADMIN_EMAILS=

# ---------- ỦNG HỘ CELES (payOS) ----------
# Bỏ trống = tắt hẳn phần nhận ủng hộ; sản phẩm vẫn chạy bình thường,
# chỉ là hạn mức miễn phí không có đường mở thêm.
# Lấy tại payOS > Kênh thanh toán > Thông tin kết nối.
# API key và checksum key CHỈ dùng phía server — không bao giờ đặt tiền tố NEXT_PUBLIC_.
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
# Địa chỉ công khai của web, dùng để dựng returnUrl/cancelUrl cho payOS
NEXT_PUBLIC_APP_URL=https://celestia-tuvi.vercel.app
# Khai báo webhook ở payOS: <NEXT_PUBLIC_APP_URL>/api/webhooks/payos

# Các con số thương mại (tuỳ chọn — bỏ trống thì dùng mặc định trong
# lib/support/config.ts). Đổi ở đây rồi redeploy, đừng sửa rải trong mã.
FREE_ASK_DAILY_LIMIT=5
SUPPORTER_DURATION_HOURS=24
SUPPORTER_ASK_QUOTA_PER_PAYMENT=30
SUPPORTER_LONG_REPORTS_PER_PAYMENT=1
SUPPORT_SUGGESTED_AMOUNTS=19000,39000,79000
MIN_SUPPORT_AMOUNT_VND=10000
MAX_SUPPORT_AMOUNT_VND=5000000

# Bí mật cho tác vụ đối soát định kỳ (/api/cron/doi-soat).
# Đặt một chuỗi ngẫu nhiên dài; Vercel Cron tự gửi nó kèm header Authorization.
# Bỏ trống = tắt hẳn tác vụ, webhook và lớp đối soát khi mở trang vẫn chạy.
CRON_SECRET=
