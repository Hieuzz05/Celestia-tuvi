# Chép thành .env.local (đã gitignore) rồi điền. Chỉ khoá CÔNG KHAI — tuyệt đối
# không đặt service role key vào app: mọi biến EXPO_PUBLIC_* đều nằm trong bundle.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Bỏ trống = production. Thử máy chủ trên máy mình: http://<IP-LAN>:3000
EXPO_PUBLIC_API_URL=
